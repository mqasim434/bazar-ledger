# Firebase (Project settings → General → Your apps → Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ImageKit (Dashboard → Developer options)
VITE_IMAGEKIT_PUBLIC_KEY=
VITE_IMAGEKIT_URL_ENDPOINT=

# Private ImageKit key must NEVER be in the client.
# Auth endpoint will be a Firebase Cloud Function (Module 18+).
# IMAGEKIT_PRIVATE_KEY=
# VITE_IMAGEKIT_AUTH_ENDPOINT=
