rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isActiveUser() {
      return !('active' in userDoc()) || userDoc().active == true;
    }

    function isStaff() {
      return isSignedIn()
        && isActiveUser()
        && (userDoc().role == 'admin' || userDoc().role == 'accountant');
    }

    function isAdmin() {
      return isSignedIn() && isActiveUser() && userDoc().role == 'admin';
    }

    // Salesman mobile uses Firestore username/password (no Firebase Auth).
    // Login docs are get-only for the app; writes stay admin/staff.
    match /salesmanLogins/{username} {
      allow get: if true;
      allow list: if isStaff();
      allow write: if isStaff();
    }

    match /users/{uid} {
      allow read: if isStaff() || (isSignedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // Operational collections: staff full access; mobile can read + create/update
    // (MVP without Firebase Auth for salesmen — harden with App Check / Cloud Functions later).
    match /salesmen/{id} {
      allow read: if true;
      allow create, delete: if isStaff();
      allow update: if isStaff() || true;
    }
    match /clients/{id} {
      allow read: if true;
      allow write: if isStaff() || true;
    }
    match /inventory/{id} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /salesmanInventory/{id} {
      allow read: if true;
      allow write: if isStaff() || true;
    }
    match /stockIssues/{id} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /inventoryAdjustments/{id} {
      allow read, write: if isStaff();
    }
    match /transactions/{id} {
      allow read: if true;
      allow create, update: if isStaff() || true;
      allow delete: if isStaff();
    }
    match /recoveries/{id} {
      allow read: if true;
      allow create, update: if isStaff() || true;
      allow delete: if isStaff();
    }
    match /salesmanDeposits/{id} {
      allow read: if true;
      allow create: if isStaff() || true;
      allow update, delete: if isStaff();
    }
    match /salesmanAdvances/{id} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /vendors/{id} { allow read, write: if isStaff(); }
    match /vendorTransactions/{id} { allow read, write: if isStaff(); }
    match /officeBalances/{id} {
      allow read: if isStaff() || true;
      allow write: if isStaff() || true;
    }

    match /returns/{id} {
      allow read: if true;
      allow create: if isStaff() || true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /expenses/{id} { allow read, write: if isAdmin(); }
    match /salesmanExpenses/{id} { allow read, write: if isAdmin(); }
    match /commissions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /commissionRules/{id} { allow read, write: if isAdmin(); }
  }
}
